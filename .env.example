# ── Database (Neon Postgres) ───────────────────────────────────────────────
# Use the *pooled* connection string from the Neon console.
DATABASE_URL=postgresql://username:password@ep-example-pooler.neon.tech/neondb?sslmode=require

# ── Auth (Better Auth) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (must be at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Public URL of this deployment (used for cookies and trusted origins)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email ──────────────────────────────────────────────────────────────────
# Optional in development: without any provider, sign-in codes are printed to
# the server console. Production needs Gmail OR Resend (Gmail wins if both).

# Option A — Gmail (no custom domain needed, ~500 emails/day).
# Needs 2-Step Verification on the account, then create an App Password at
# https://myaccount.google.com/apppasswords (16 characters).
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_FROM_NAME=Clubhouse

# Option B — Resend (requires a domain verified at resend.com/domains).
RESEND_API_KEY=
RESEND_FROM_EMAIL=Clubhouse <no-reply@yourdomain.com>

# ── Optional tuning ────────────────────────────────────────────────────────
# Max DB connections per server instance (default 10).
# DATABASE_POOL_MAX=10
